{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harbour.github.io/schema/hbast.schema.json",
  "title": "Harbour AST Payload",
  "type": "object",
  "required": [
    "format_version",
    "schema_revision",
    "generator",
    "project",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "schema_revision": {
      "type": "integer",
      "minimum": 1
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/symbolEntry"
      },
      "default": []
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnosticEntry"
      },
      "default": []
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "build": {
          "type": "string"
        }
      }
    },
    "project": {
      "type": "object",
      "required": ["root", "dialect"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "string"
        },
        "dialect": {
          "type": "string"
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "fileEntry": {
      "type": "object",
      "required": ["file_id", "path", "hash", "ast"],
      "additionalProperties": false,
      "properties": {
        "file_id": {
          "type": "integer",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "hash": {
          "type": "string"
        },
        "ast": {
          "$ref": "#/$defs/astPayload"
        },
        "macros": {
          "$ref": "#/$defs/macroPayload"
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "line_endings": {
              "type": "string",
              "enum": ["lf", "crlf", "cr"]
            },
            "encoding": {
              "type": "string"
            }
          }
        }
      }
    },
    "astPayload": {
      "type": "object",
      "required": ["root", "nodes"],
      "additionalProperties": false,
      "properties": {
        "root": {
          "type": "integer",
          "minimum": 0
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nodeEntry"
          },
          "default": []
        },
        "token_stream": {
          "$ref": "#/$defs/tokenStream"
        }
      }
    },
    "nodeEntry": {
      "type": "object",
      "required": ["id", "kind", "range", "stable_id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/sourceRange"
        },
        "stable_id": {
          "type": "string"
        },
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "children": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "tokens": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "symbol": {
          "type": "integer",
          "minimum": 0
        },
        "type": {
          "$ref": "#/$defs/typeHint"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        },
        "doc": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tokenStream": {
      "type": "object",
      "required": ["tokens"],
      "additionalProperties": false,
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tokenEntry"
          }
        }
      }
    },
    "tokenEntry": {
      "type": "object",
      "required": ["id", "kind", "channel", "original", "expanded"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "channel": {
          "type": "string",
          "enum": ["code", "comment", "directive", "trivia"]
        },
        "original": {
          "$ref": "#/$defs/sourceRange"
        },
        "expanded": {
          "$ref": "#/$defs/sourceRange"
        },
        "macro_origin": {
          "type": "integer",
          "minimum": 0
        },
        "lexeme": {
          "type": "string"
        }
      }
    },
    "sourceRange": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": {
          "$ref": "#/$defs/sourceCoord"
        },
        "end": {
          "$ref": "#/$defs/sourceCoord"
        }
      }
    },
    "sourceCoord": {
      "type": "object",
      "required": ["line", "column", "offset"],
      "additionalProperties": false,
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "macroPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expansions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/macroExpansion"
          }
        }
      }
    },
    "macroExpansion": {
      "type": "object",
      "required": ["expansion_id", "macro_name", "call_site"],
      "additionalProperties": false,
      "properties": {
        "expansion_id": {
          "type": "integer",
          "minimum": 0
        },
        "macro_name": {
          "type": "string"
        },
        "definition_range": {
          "$ref": "#/$defs/sourceReference"
        },
        "call_site": {
          "$ref": "#/$defs/tokenReference"
        },
        "arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "output_tokens": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        }
      }
    },
    "symbolEntry": {
      "type": "object",
      "required": ["symbol_id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "symbol_id": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "qualified_name": {
          "type": "string"
        },
        "declarations": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "references": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "default": []
        },
        "scope": {
          "$ref": "#/$defs/scopeDescriptor"
        },
        "annotations": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "scopeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "typeHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hint": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        }
      }
    },
    "diagnosticEntry": {
      "type": "object",
      "required": ["severity", "code", "message", "range"],
      "additionalProperties": false,
      "properties": {
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "info", "hint"]
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "range": {
          "$ref": "#/$defs/sourceReference"
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedInformation"
          },
          "default": []
        },
        "fixes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/codeFix"
          },
          "default": []
        }
      }
    },
    "relatedInformation": {
      "type": "object",
      "required": ["file", "range"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "range": {
          "$ref": "#/$defs/sourceRange"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "codeFix": {
      "type": "object",
      "required": ["title", "edits"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string"
        },
        "edits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceEdit"
          }
        }
      }
    },
    "sourceEdit": {
      "type": "object",
      "required": ["file", "range", "text"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "range": {
          "$ref": "#/$defs/sourceRange"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "sourceReference": {
      "type": "object",
      "required": ["file", "range"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "range": {
          "$ref": "#/$defs/sourceRange"
        }
      }
    },
    "tokenReference": {
      "type": "object",
      "required": ["file", "token"],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "integer",
          "minimum": 0
        },
        "token": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
